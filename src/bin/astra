#!/system/bin/sh
# Astra CLI / WebUI 后端  Beta0.3.0
ASTRA_MODDIR=${ASTRA_MODDIR:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)}
. "$ASTRA_MODDIR/bin/lib.sh"

# 无 fork 数字清洗：num 值 -> NB
num() { case "$1" in ''|*[!0-9-]*) NB=0 ;; *) NB=$1 ;; esac; }

# 常见应用名（避免为每个包 fork 一次 dumpsys package）
app_name() {
	case "$1" in
	com.tencent.mm) echo "微信" ;;
	com.tencent.mobileqq) echo "QQ" ;;
	com.tencent.tim) echo "TIM" ;;
	com.taobao.taobao) echo "淘宝" ;;
	com.jingdong.app.mall) echo "京东" ;;
	com.xunmeng.pinduoduo) echo "拼多多" ;;
	com.eg.android.AlipayGphone) echo "支付宝" ;;
	com.sina.weibo) echo "微博" ;;
	com.ss.android.ugc.aweme) echo "抖音" ;;
	com.smile.gifmaker) echo "快手" ;;
	com.xingin.xhs) echo "小红书" ;;
	com.bilibili.app.in) echo "哔哩哔哩" ;;
	com.zhihu.android) echo "知乎" ;;
	com.netease.cloudmusic) echo "网易云音乐" ;;
	com.tencent.qqmusic) echo "QQ音乐" ;;
	com.android.chrome) echo "Chrome" ;;
	com.android.launcher) echo "桌面" ;;
	com.android.settings) echo "设置" ;;
	com.omarea.vtools) echo "Scene" ;;
	com.sukisu.ultra) echo "SukiSU" ;;
	com.android.systemui) echo "系统界面" ;;
	com.oplus.battery) echo "电池" ;;
	com.coolapk.market) echo "酷安" ;;
	com.max.xiaoheihe) echo "小黑盒" ;;
	com.tencent.tmgp.sgame) echo "王者荣耀" ;;
	com.tencent.tmgp.pubgmhd) echo "和平精英" ;;
	com.miHoYo.Yuanshen) echo "原神" ;;
	com.miHoYo.hkrpg) echo "崩坏：星穹铁道" ;;
	*) echo "${1##*.}" ;;
	esac
}

do_status() {
	cfg_load
	st_load
	ensure_zone_cache

	real_batt_md; rb=$RB
	real_soc_md; rs=$RS

	IFS= read -r st <"$BATT/status" 2>/dev/null; [ -z "$st" ] && st=Unknown
	IFS= read -r cap <"$BATT/capacity" 2>/dev/null
	IFS= read -r hl <"$BATT/health" 2>/dev/null; [ -z "$hl" ] && hl=Unknown
	IFS= read -r cy <"$BATT/cycle_count" 2>/dev/null
	IFS= read -r cf <"$BATT/charge_full" 2>/dev/null
	IFS= read -r cd <"$BATT/charge_full_design" 2>/dev/null
	IFS= read -r cn <"$BATT/charge_now" 2>/dev/null
	IFS= read -r cc <"$BATT/charge_counter" 2>/dev/null

	num "$cf"; cf=$NB; cf=$((cf / 1000))
	num "$cd"; cd=$NB; cd=$((cd / 1000))
	num "$cap"; cap=$NB
	num "$cy"; cy=$NB
	# 剩余电量（mAh）：优先用百分比 × 满充容量（充电/放电都准），其次 charge_now / charge_counter
	num "$cn"; cn=$NB
	num "$cc"; cc=$NB; cc=$((cc / 1000))
	remain=0
	[ "$cap" -gt 0 ] && [ "$cf" -gt 0 ] && remain=$((cap * cf / 100))
	[ "$remain" -le 0 ] && remain=$cn
	[ "$remain" -le 0 ] && remain=$cc
	[ "$cf" -gt 0 ] && [ "$remain" -gt "$cf" ] && remain=$cf

	power_mw; wmw=$PMW
	# 电池页的“充电功率”只统计真正在充电时的功率；未充电/已充满一律 0。
	charge_power_mw; cpmw=$CPMW
	pack_mv
	# Use the smoothed power sample for the average, never a short counter interval.
	avgw=0
	case "${ST_AVG_MW:-}" in ''|*[!0-9]*) ;; *) avgw=$ST_AVG_MW ;; esac
	case "$st" in
	Charging) curw=$wmw ;;
	Full) curw=0 ;;
	*)
		curw=0
		[ "${CURR_MA:-0}" -gt 0 ] && curw=$(( 0 - CURR_MA * PACK_MV / 1000 ))
		;;
	esac

	# 是否插着充电器（与“是否正在充电”分开：充满/暂停时仍算已连接）
	online=0
	uon=""
	IFS= read -r uon <"$USB/online" 2>/dev/null
	[ "$uon" = "1" ] && online=1
	case "$st" in Charging|Full|"Not charging") online=1 ;; esac
	el=0
	if [ "$st" = "Charging" ] && [ "${ST_CHARGE_START:-0}" -gt 0 ] 2>/dev/null; then
		el=$(( $(date +%s) - ST_CHARGE_START ))
	fi

	mode=$CFG_THERMAL_MODE
	applied=$CFG_MASK_BASE
	[ "$ST_MASK_ACTIVE" = "1" ] && applied=${MASK_APPLIED:-$CFG_MASK_BASE}

	little=0; prime=0
	for p in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		IFS= read -r rc <"$p/related_cpus" 2>/dev/null
		IFS= read -r mx <"$p/scaling_max_freq" 2>/dev/null
		num "$mx"
		case " $rc " in
		*" 6 "*|*" 7 "*) prime=$NB ;;
		*) little=$NB ;;
		esac
	done

	[ -f "$DEV_CACHE" ] || cache_device
	DM=; DRR=; DK=; RR=
	while IFS='=' read -r k v; do
		case "$k" in
		MODEL) DM=$v ;;
		ROM) DRR=$v ;;
		KERNEL) DK=$v ;;
		ROOT) RR=$v ;;
		esac
	done <"$DEV_CACHE"

	VER=
	while IFS='=' read -r k v; do
		[ "$k" = "version" ] && { VER=$v; break; }
	done <"$MODDIR/module.prop" 2>/dev/null

	gpu_forced=0; [ "$ST_SAVE_APPLIED" = "1" ] && gpu_forced=1

	thermal_mount_count
	n_off=0
	[ "$mode" = "off" ] && [ "$MOUNT_COUNT" -gt 0 ] && n_off=1
	num "$MOUNT_COUNT"; n_mounts=$NB
	num "$CFG_MASK_BASE"; n_base=$NB
	num "$applied"; n_app=$NB
	num "$rb"; n_rb=$NB
	num "$rs"; n_rs=$NB
	num "$ST_MASK_LATCH"; n_latch=$NB
	num "$CFG_SCENE_SEES_FAKE"; n_scene=$NB
	num "$CFG_RAISE_WALL"; n_wall=$NB
	num "$CFG_MASK_FUSE_BATT"; n_fb=$NB
	num "$CFG_MASK_FUSE_SOC"; n_fs=$NB
	num "$CFG_CHARGE_AUTO"; n_ca=$NB
	num "$CFG_CHARGE_NOW"; n_cn=$NB
	num "$ST_CHARGE_APPLIED"; n_capp=$NB
	num "$ST_CHARGE_GUARD"; n_cg=$NB
	num "$CFG_CHARGE_TEMP_CUT"; n_cut=$NB
	num "$CFG_SAVE_ENABLED"; n_save=$NB
	num "$ST_SAVE_APPLIED"; n_save_applied=$NB
	num "$CFG_DISABLE_GPU_BOOST"; n_gpu=$NB
	[ "$ST_SAVE_APPLIED" = "1" ] && n_gpu=1
	num "$CFG_DEEP_SLEEP"; n_deep=$NB
	num "$CFG_DUAL_COMP"; n_dual=$NB
	num "$ST_DS_ACTIVE"; n_dsa=$NB
	num "$ST_DS_LAST"; n_dsl=$NB
	num "$ST_FG_GAME"; n_game=$NB
	num "$little"; n_l=$NB
	num "$prime"; n_p=$NB
	num "$ST_RADIO_LATCH"; n_radio=$NB
	num "$cpmw"; n_cpmw=$NB
	num "$CFG_LTPO"; n_ltpo=$NB
	ltpo_m=0
	ltpo_mounted && ltpo_m=1
	ltpo_p=0
	[ -s "$LTPO_SRC" ] && ltpo_p=1
	vrr=$(getprop "$LTPO_PROP" 2>/dev/null)

	# 单行输出：某些 root 桥接（libsu fastCmd）只取第一行，必须压成一行
	cat <<EOF | tr -d '\n'
{"version":"$VER",
"device":{"model":"$DM","rom":"$DRR","kernel":"$DK","root":"$RR"},
"thermal":{"mode":"$mode","off":$n_off,"mounts":$n_mounts,
 "mask":{"base":$n_base,"applied":$n_app,"real_batt":$n_rb,"real_soc":$n_rs,
  "latch":$n_latch,"radio":$n_radio,"scene_fake":$n_scene,"wall":$n_wall,"fuse_batt":$n_fb,"fuse_soc":$n_fs}},
"charge":{"online":$online,"status":"$st","watts":$n_cpmw,"avg":$avgw,"cur":$curw,"elapsed":$el,
 "temp":$n_rb,"capacity":$cap,"health":"$hl","cycle":$cy,"remain":$remain,
 "full":$cf,"design":$cd,"auto":$n_ca,"now":$n_cn,"applied":$n_capp,"guard":$n_cg,"cut":$n_cut},
"display":{"ltpo":$n_ltpo,"mounted":$ltpo_m,"vrr":"$vrr","payload":$ltpo_p},
"sched":{"save":$n_save,"save_applied":$n_save_applied,"gpu":$n_gpu,"gpu_forced":$gpu_forced,"gpu_state":"${ST_GPU_STATE:-unknown}","game":$n_game,
 "scene":$(num "${ST_SCENE_TAKEOVER:-0}"; echo $NB),"deep":$n_deep,"dsactive":$n_dsa,"dslast":$n_dsl,"dual":$n_dual,
 "little":$n_l,"prime":$n_p},
"lang":"$CFG_LANG"}
EOF
	printf '\n'
}

# ---------------------------------------------------------------- 应用耗电（自采样，Scene 风格）
do_apps() {
	cfg_load
	st_load
	now=$(date +%s)
	pack_mv
	[ -s "$USAGE_DB" ] || { echo '[]'; return; }
	sort -t'|' -k3,3nr "$USAGE_DB" 2>/dev/null | head -3 >"$STATE/tmp/apps"
	# 没有库仑计样本时（刚播种/充电早期）用当前平均电流估算
	eff=$(( ${AVG_MA:-0} ))
	case "$eff" in ''|*[!0-9]*) eff=0 ;; esac
	[ "$eff" -le 0 ] && eff=400
	first=1
	printf '['
	while IFS='|' read -r pkg sec at uah; do
		[ -z "$pkg" ] && continue
		case "$sec" in ''|*[!0-9]*) sec=0 ;; esac
		case "$at" in ''|*[!0-9]*) at=$now ;; esac
		case "$uah" in ''|*[!0-9]*) uah=0 ;; esac
		[ "$sec" -le 0 ] && continue
		if [ "$uah" -gt 0 ]; then
			mah10=$(( uah / 100 ))
			ma=$(( uah * 3600 / sec / 1000 ))
		else
			mah10=$(( sec * eff * 10 / 3600 ))
			ma=$eff
		fi
		mw=$(( ma * PACK_MV / 1000 ))
		lbl=$(app_name "$pkg")
		[ $first -eq 1 ] || printf ','
		first=0
		printf '{"pkg":"%s","label":"%s","ago":%s,"dur":%s,"mah":"%s.%s","w":"%s.%s"}' \
			"$pkg" "$lbl" "$((now - at))" "$sec" \
			"$((mah10 / 10))" "$((mah10 % 10))" \
			"$((mw / 1000))" "$((mw % 1000 / 10))"
	done <"$STATE/tmp/apps"
	printf ']\n'
}
do_seed() {
	now=$(date +%s)
	[ -s "$USAGE_DB" ] && return 0
	dumpsys usagestats 2>/dev/null | grep -E 'type=ACTIVITY_(RESUMED|PAUSED|STOPPED)' \
	| sed -n 's/.*time="\([^"]*\)".*type=\([A-Z_]*\).*package=\([^ ]*\).*/\1|\2|\3/p' \
	| awk -F'|' -v now="$now" '
	function ep(s,  d,t,y,mo,da,h,mi,se,era,yoe,doy,doe) {
		split(s,d," "); split(d[1],t,"-"); y=t[1]+0; mo=t[2]+0; da=t[3]+0
		split(d[2],t,":"); h=t[1]+0; mi=t[2]+0; se=t[3]+0
		if (mo<=2) y--
		era=int(y/400); yoe=y-era*400
		doy=int((153*((mo>2)?mo-3:mo+9)+2)/5)+da-1
		doe=yoe*365+int(yoe/4)-int(yoe/100)+doy
		return (era*146097+doe-719468)*86400+h*3600+mi*60+se
	}
	{
		t=ep($1); p=$3
		if ($2=="ACTIVITY_RESUMED") { if (!(p in seen)) seen[p]=1; start[p]=t }
		else if (start[p]>0) { dur[p]+=t-start[p]; start[p]=0 }
		last[p]=t
	}
	END { for (p in seen) printf "%s|%d|%d|0\n", p, dur[p]+0, last[p]+0
	}' | sort -t'|' -k2 -nr | head -40 >"$USAGE_DB" 2>/dev/null
	chmod 0600 "$USAGE_DB" 2>/dev/null
}

# ---------------------------------------------------------------- 平均功耗（Scene 式：电池统计折算）
do_avg() {
	cfg_load
	st_load
	mw=0
	case "${ST_AVG_MW:-}" in ''|*[!0-9]*) ;; *) mw=$ST_AVG_MW ;; esac
	pack_mv
	ma=0
	[ "$PACK_MV" -gt 0 ] && ma=$(( mw * 1000 / PACK_MV ))
	printf '{"mw":%s,"w":%s.%s,"ma":%s}\n' "$mw" "$((mw / 1000))" "$((mw % 1000 / 10))" "$ma"
}

# ---------------------------------------------------------------- 耗电详情（系统统计，作参考）
parse_sec() { # 小字符串，不要传整份 dump
	echo "$1" | awk '{s=0; for(i=1;i<=NF;i++){v=$i;n=v+0; if(v~/h$/)s+=n*3600; else if(v~/m$/)s+=n*60; else if(v~/s$/)s+=n}; print s}'
}
do_detail() {
	dumpsys batterystats --charged 2>/dev/null \
		| grep -E "Time on battery:|Time on battery screen off:|actual drain:" \
		| head -3 >"$STATE/tmp/bstat"
	tot=$(grep "Time on battery:" "$STATE/tmp/bstat" | sed 's/.*Time on battery: *//')
	off=$(grep "screen off:" "$STATE/tmp/bstat" | sed 's/.*screen off: *//')
	drain=$(grep "actual drain:" "$STATE/tmp/bstat" | sed 's/.*actual drain: *\([0-9][0-9]*\).*/\1/')
	tsec=$(parse_sec "$tot")
	osec=$(parse_sec "$off")
	case "$tsec" in ''|*[!0-9]*) tsec=0 ;; esac
	case "$osec" in ''|*[!0-9]*) osec=0 ;; esac
	case "$drain" in ''|*[!0-9]*) drain=0 ;; esac
	ssec=$((tsec - osec))
	[ "$ssec" -lt 0 ] && ssec=0
	avgma=0
	[ "$tsec" -gt 0 ] && [ "$drain" -gt 0 ] && avgma=$(( drain * 3600 / tsec ))
	printf '{"drain":%s,"total":%s,"on":%s,"off":%s,"avg_ma":%s}\n' "$drain" "$tsec" "$ssec" "$osec" "$avgma"
}

read_debug_node() {
	DEBUG_NODE_VALUE=unreadable
	[ -r "$1" ] || return 0
	IFS= read -r DEBUG_NODE_VALUE <"$1" 2>/dev/null || DEBUG_NODE_VALUE=unreadable
}

case "$1" in
status) do_status ;;
detail) do_detail ;;
avg) do_avg ;;
apps) do_apps ;;
seed-usage) do_seed ;;
tick) tick ;;
report)
	out="$LOGS/debug-$(date +%Y%m%d-%H%M%S).txt"
	mkdir -p "$SDCARD/Astra" 2>/dev/null
	{
		echo "Astra debug report"; date
		echo "module=$(grep '^version=' "$MODDIR/module.prop" 2>/dev/null | cut -d= -f2) model=$(getprop ro.product.model) soc=$(getprop ro.soc.model)"
		echo "== config =="; cat "$CONF" 2>/dev/null
		echo "== state =="; cat "$STATE_FILE" 2>/dev/null
		echo "== battery =="; for f in temp status current_now voltage_now charge_counter capacity health cycle_count charge_full charge_full_design; do
			read_debug_node "$BATT/$f"; echo "$f=$DEBUG_NODE_VALUE"; done
		echo "== USB input =="; for f in "$USB/current_now" "$USB/voltage_now" "$USB/current_max" "$USB/voltage_max" "$USB/input_current_limit"; do
			read_debug_node "$f"; echo "$f=$DEBUG_NODE_VALUE"; done
		echo "== charging controls =="; for f in "$BATT/input_current_limit" "$OPLUS/fast_charge" "$OPLUS/cool_down" "$OPLUS/normal_cool_down"; do
			read_debug_node "$f"; echo "$f=$DEBUG_NODE_VALUE"; done
		echo "== zones =="; for d in "$THERMAL"/thermal_zone*; do
			IFS= read -r t <"$d/type" 2>/dev/null; IFS= read -r v <"$d/temp" 2>/dev/null
			echo "$(basename "$d") $t $v"; done
		echo "== thermal mounts =="; cat "$MNT" 2>/dev/null; thermal_mount_count; echo "verified_mount_count=$MOUNT_COUNT"
		echo "orms_service=$(getprop "init.svc.$ORMS_SVC" 2>/dev/null)"
		echo "== caps =="; IFS= read -r c <"$CAP_NODE" 2>/dev/null; echo "$c"
		echo "== cpufreq =="; for p in /sys/devices/system/cpu/cpufreq/policy*; do
			IFS= read -r a <"$p/scaling_max_freq"; IFS= read -r b <"$p/cpuinfo_max_freq"; echo "$p $a/$b"; done
		echo "== gpu =="; for d in /sys/class/devfreq/*; do echo "$d min=$(cat $d/min_freq 2>/dev/null) max=$(cat $d/max_freq 2>/dev/null)"; done
		for d in /sys/class/kgsl/kgsl-3d0 /sys/class/kgsl/*; do [ -e "$d/dcvs_boost" ] && echo "dcvs_boost=$d/dcvs_boost:$(cat "$d/dcvs_boost" 2>/dev/null)"; done
		echo "== doze =="
		echo "deep_sleep=${CFG_DEEP_SLEEP} dsactive=${ST_DS_ACTIVE:-0} dslast=${ST_DS_LAST:-0} doze_marker=$([ -f "$STATE/.doze.active" ] && echo 1 || echo 0)"
		dumpsys deviceidle 2>/dev/null | grep -E 'mState=|mLightState=|mForceIdle=|mScreenOn=|mCharging=' | head -6
		echo "== recent log =="; tail -n 150 "$LOGS/astra.log" 2>/dev/null
		[ -f "$LOGS/astra.log.1" ] && { echo "== previous log =="; tail -n 50 "$LOGS/astra.log.1"; }
	} >"$out" 2>&1
	cp -f "$out" "$SDCARD/Astra/$(basename "$out")" 2>/dev/null
	echo "$out"
	;;
selftest)
	out="$LOGS/selftest.txt"
	mkdir -p "$SDCARD/Astra" 2>/dev/null
	{
		echo "Astra selftest"; date; id
		for t in shell_front shell_back sys-therm-0 battery socd; do
			i=$(zone_idx "$t")
			if [ -z "$i" ]; then echo "$t: NOT FOUND"; continue; fi
			if ! zone_spoof_ok "$i" "$t"; then
				case "$t" in
				battery) ;;   # 电池热区按需伪装，默认允许
				*) echo "$t: SKIPPED (unsafe zone: type=$(cat "$THERMAL/thermal_zone$i/type" 2>/dev/null) trip0=$(cat "$THERMAL/thermal_zone$i/trip_point_0_temp" 2>/dev/null))"; continue ;;
				esac
			fi
			IFS= read -r before <"$THERMAL/thermal_zone$i/temp"
			emu_write "$i" 26600; sleep 1
			IFS= read -r after <"$THERMAL/thermal_zone$i/temp"
			emu_write "$i" 0; sleep 1
			IFS= read -r back <"$THERMAL/thermal_zone$i/temp"
			echo "$t: idx=$i before=$before fake=$after back=$back $( [ "$after" = "26600" ] && echo WRITE_OK || echo WRITE_FAIL )"
		done
		echo "caps: $(cat "$CAP_NODE" 2>/dev/null)"
	} >"$out" 2>&1
	cp -f "$out" "$SDCARD/Astra/selftest.txt" 2>/dev/null
	echo "$out"
	;;
set)
	# cfg_set/cfg_load 内部会用 k/v 作为临时变量，这里先存一份，
	# 否则下面 case 匹配到的是配置文件最后一行的键名（旧 bug：开关要等守护进程下一轮才生效）
	_k="$2"; _v="$3"
	cfg_set "$_k" "$_v"; cfg_load; st_load
	case "$_k" in
	CHARGE_AUTO|CHARGE_NOW|CHARGE_TEMP_CUT) charge_tick ;;
	SAVE_ENABLED|DISABLE_GPU_BOOST) sched_tick ;;
	DEEP_SLEEP) deep_sleep_tick ;;
	DUAL_COMP) : ;;
	LTPO_ENABLE)
		if [ "$CFG_LTPO" = "1" ]; then ltpo_apply; else ltpo_remove; fi
		;;
	SCENE_SEES_FAKE|MASK_BASE|MASK_AMP) [ "$ST_MASK_ACTIVE" = "1" ] && mask_tick ;;
	esac
	st_save
	ST_PROP_AT=0
	update_prop
	do_status
	;;
thermal)
	mode=${2:-official}
	case "$mode" in off|mask|official) ;; *) echo "invalid thermal mode: $mode" >&2; exit 2 ;; esac
	if ! mode_lock_acquire; then echo "thermal mode is busy; try again" >&2; exit 1; fi
	cfg_set THERMAL_MODE "$mode"
	cfg_load; st_load
	# 清理旧版本可能残留在别的热区上的仿真值（emul_temp 不能回读，只能全量写 0）
	emu_clear_all
	case "$mode" in
	off) mask_off; ST_MASK_LATCH=0; ST_RADIO_LATCH=0; thermal_off_keep ;;
	mask) thermal_off_off; ST_MASK_LATCH=0; ST_RADIO_LATCH=0; mask_tick ;;
	official) thermal_all_clear ;;
	esac
	st_save
	ST_PROP_AT=0
	update_prop
	mode_lock_release
	do_status
	;;
charge)
	cfg_load; st_load
	case "$2" in
	now) [ "${3:-on}" = "on" ] && cfg_set CHARGE_NOW 1 || cfg_set CHARGE_NOW 0 ;;
	auto) [ "${3:-on}" = "on" ] && cfg_set CHARGE_AUTO 1 || cfg_set CHARGE_AUTO 0 ;;
	esac
	cfg_load; charge_tick; st_save; ST_PROP_AT=0; update_prop; do_status
	;;
sched)
	cfg_load; st_load
	case "$2" in
	save)
		if [ "${3:-on}" = "on" ]; then
			cfg_set SAVE_ENABLED 1
			# Do not carry a stale foreground-game/Scene decision into an explicit enable.
			FG_AT=0; ST_FG_GAME=0; ST_SCENE_TAKEOVER=0
		else
			cfg_set SAVE_ENABLED 0
		fi
		;;
	gpu) [ "${3:-on}" = "on" ] && cfg_set DISABLE_GPU_BOOST 1 || cfg_set DISABLE_GPU_BOOST 0 ;;
	deep) [ "${3:-on}" = "on" ] && cfg_set DEEP_SLEEP 1 || cfg_set DEEP_SLEEP 0 ;;
	esac
	cfg_load; sched_tick; deep_sleep_tick; st_save; ST_PROP_AT=0; update_prop; do_status
	;;
log) tail -n "${2:-150}" "$LOGS/astra.log" 2>/dev/null ;;
zones) ensure_zone_cache; cat "$ZONE_SPOOF" "$ZONE_BATTERY" "$ZONE_WITNESS" ;;
*) echo "astra status|apps|set <K> <V>|thermal <off|mask|official>|charge <now|auto> <on|off>|sched <save|gpu|deep> <on|off>|report|selftest|log" ;;
esac
